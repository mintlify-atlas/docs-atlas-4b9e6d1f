  "keyFeatures": [
    "Client-only architecture — no server backend required",
    "devcontainer.json standard compatibility (same as GitHub Codespaces)",
    "Multi-backend support: Docker, Kubernetes, cloud VMs, remote SSH machines",
    "Full IDE support: VS Code, JetBrains suite, Zed, Cursor, Jupyter, RStudio, and more",
    "Desktop application with GUI for workspace management",
    "Prebuild support for faster workspace startup",
    "Automatic inactivity shutdown to save costs",
    "Git and Docker credentials sync into containers",
    "Dotfiles support for personalized environments",
    "Extensible provider system — write your own custom providers",
    "DevPod Pro for team/enterprise features via Kubernetes"
  ],
